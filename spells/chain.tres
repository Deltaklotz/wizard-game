script = ExtResource("1")
theme_color = Color(0.7, 0.92, 0.2, 1)
spell_name = "Spectral Chain"
description = "Loose a chain of bound souls that wanders where the eye leads. It hauls the caster to whatever it bites into, or drags a foe to the caster's feet. Every fathom drinks mana as it flies; cast again to let it shatter."
